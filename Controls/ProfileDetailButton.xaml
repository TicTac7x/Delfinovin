<UserControl
    x:Class="Delfinovin.Controls.ProfileDetailButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:main="clr-namespace:Delfinovin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="80"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50" />
            <ColumnDefinition />
            <ColumnDefinition Width="80" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="profileBackground"
            Grid.ColumnSpan="3"
            Background="#4741484E"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="5" />

        <Image
            x:Name="favoriteStatus"
            Width="30"
            Height="30"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MouseLeftButtonDown="FavoriteStatus_MouseLeftButtonDown"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="/Delfinovin;component/Resources/Icons/not-favorite.png" />

        <StackPanel
            x:Name="profileInfoContainer"
            Grid.Column="1"
            VerticalAlignment="Center"
            Orientation="Vertical">

            <StackPanel.Resources>
                <Style TargetType="{x:Type Label}">
                    <Setter Property="Foreground" Value="{DynamicResource textColor}" />
                    <Setter Property="FontFamily" Value="Lato Light" />
                </Style>
            </StackPanel.Resources>

            <Label
                x:Name="profileName"
                Content="{x:Static main:Strings.DetailsDefaultName}"
                FontSize="16" />

            <Label
                x:Name="profileDetails"
                Margin="0,-5,0,0"
                Content="{x:Static main:Strings.DetailsDefaultInfo}"
                FontSize="12" />
        </StackPanel>
    </Grid>
</UserControl>
