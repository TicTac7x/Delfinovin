<Window
    x:Class="Delfinovin.Controls.Windows.ControllerSettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Delfinovin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:main="clr-namespace:Delfinovin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static main:Strings.HeaderControllerSettings}"
    Width="900"
    Height="500"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.Resources>
            <ResourceDictionary>
                <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="{x:Type Button}">
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="0,5,7,10" />
                    <Setter Property="BorderBrush" Value="Black" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource normalButtonColor}" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <Border
            x:Name="mainBackground"
            Grid.RowSpan="4"
            Grid.ColumnSpan="2"
            Background="{DynamicResource headerGradient}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="15,15,15,15" />

        <Border
            x:Name="navigationBar"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Background="{DynamicResource controllerBarGradient}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="0,0,15,15" />

        <ctrl:ApplicationTitleLabel
            x:Name="settingsWindowTitle"
            Grid.ColumnSpan="2"
            HeaderText="{x:Static main:Strings.HeaderControllerSettings}" />

        <ctrl:WindowControls
            x:Name="windowControls"
            Grid.Column="1"
            HorizontalAlignment="Right" />


        <Viewbox
            x:Name="dialogContainer"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,35,50,25"
            HorizontalAlignment="Right">

            <ctrl:GamecubeDialog x:Name="controllerDialog" />
        </Viewbox>

        <StackPanel
            x:Name="settingContainer"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Width="300"
            Margin="10,0,0,0"
            HorizontalAlignment="Left">

            <StackPanel.Resources>
                <Style TargetType="ctrl:SliderListItem">
                    <Setter Property="Margin" Value="10" />
                </Style>

                <Style TargetType="ctrl:ToggleButtonListItem">
                    <Setter Property="Margin" Value="10" />
                </Style>
            </StackPanel.Resources>

            <ctrl:SliderListItem
                x:Name="triggerDeadzone"
                ItemText="{x:Static main:Strings.SettingTriggerDeadzone}"
                Maximum="100"
                Minimum="0" />

            <ctrl:SliderListItem
                x:Name="triggerThreshold"
                ItemText="{x:Static main:Strings.SettingTriggerThreshold}"
                Maximum="100"
                Minimum="0" />

            <ctrl:SliderListItem
                x:Name="leftStickRange"
                ItemText="{x:Static main:Strings.SettingLeftStickRange}"
                Maximum="100"
                Minimum="0" />

            <ctrl:SliderListItem
                x:Name="leftStickDeadzone"
                ItemText="{x:Static main:Strings.SettingLeftStickDeadzone}"
                Maximum="100"
                Minimum="0"
                Tag="{x:Static main:Sticks.LStick}"
                ValueChanged="StickDeadzoneValueChanged" />

            <ctrl:SliderListItem
                x:Name="rightStickRange"
                ItemText="{x:Static main:Strings.SettingRightStickRange}"
                Maximum="100"
                Minimum="0" />

            <ctrl:SliderListItem
                x:Name="rightStickDeadzone"
                ItemText="{x:Static main:Strings.SettingRightStickDeadzone}"
                Maximum="100"
                Minimum="0"
                Tag="{x:Static main:Sticks.LStick}"
                ValueChanged="StickDeadzoneValueChanged" />

            <ctrl:ToggleButtonListItem
                x:Name="enableRumble"
                ItemText="{x:Static main:Strings.SettingEnableRumble}"
                ToggleValueChanged="RumbleToggleValueChanged" />

            <ctrl:ToggleButtonListItem
                x:Name="swapControlSticks"
                ItemText="{x:Static main:Strings.SettingSwapSticks}"
                ToggleValueChanged="SwapSticksToggleValueChanged" />

            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal">

                <Button
                    x:Name="buttonMapping"
                    Click="ButtonMapping_Click"
                    Content="{x:Static main:Strings.ButtonMapping}" />
            </StackPanel>

        </StackPanel>

        <StackPanel
            x:Name="optionsContainer"
            Grid.Row="2"
            Grid.Column="2"
            Margin="5,5,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button
                x:Name="restoreDefaults"
                Click="RestoreDefaults_Click"
                Content="{x:Static main:Strings.RestoreDefaults}" />

            <Button
                x:Name="saveProfile"
                Click="SaveProfile_Click"
                Content="{x:Static main:Strings.SaveProfile}" />

            <Button
                x:Name="applySettings"
                Click="ApplySettings_Click"
                Content="{x:Static main:Strings.ApplySettings}" />

        </StackPanel>
    </Grid>
</Window>
