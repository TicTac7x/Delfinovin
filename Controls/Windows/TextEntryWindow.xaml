<Window
    x:Class="Delfinovin.Controls.Windows.TextEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Delfinovin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:main="clr-namespace:Delfinovin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static main:Strings.HeaderTextEntry}"
    Width="700"
    Height="200"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,5,10,5" />
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{DynamicResource normalButtonColor}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border
            x:Name="mainBackground"
            Grid.RowSpan="3"
            Background="{DynamicResource headerGradient}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="15,15,15,15" />

        <Border
            x:Name="optionsBackground"
            Grid.Row="2"
            Background="{DynamicResource controllerBarGradient}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="0,0,15,15" />

        <TextBox
            x:Name="textEntry"
            Grid.RowSpan="2"
            Width="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="24"
            Foreground="{DynamicResource textColor}"
            GotFocus="TextEntry_GotFocus"
            TextAlignment="Center"
            TextChanged="TextEntry_TextChanged"
            TextWrapping="Wrap">

            <TextBox.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    ShadowDepth="0"
                    Color="#FF000000" />

            </TextBox.Effect>
        </TextBox>

        <ctrl:ApplicationTitleLabel x:Name="textWindowTitle" />

        <ctrl:WindowControls
            x:Name="windowControls"
            HorizontalAlignment="Right"
            MinimizeButtonVisibility="Collapsed" />

        <StackPanel
            x:Name="optionsContainer"
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <Button x:Name="saveButton" Click="SaveButton_Click" />

        </StackPanel>
    </Grid>
</Window>
