<Window
    x:Class="Delfinovin.Controls.Windows.MessageDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Delfinovin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:forms="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
    xmlns:main="clr-namespace:Delfinovin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static main:Strings.HeaderMessagePrompt}"
    Width="700"
    Height="200"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid x:Name="controlContainer">
        <Grid.RowDefinitions>
            <RowDefinition Height="35" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <Border
            x:Name="mainBackground"
            Grid.RowSpan="3"
            Background="{DynamicResource headerGradient}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="15,15,15,15" />

        <Border
            x:Name="optionsBar"
            Grid.Row="2"
            Background="{DynamicResource controllerBarGradient}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="0,0,15,15" />

        <ctrl:ApplicationTitleLabel x:Name="messageWindowTitle" HeaderText="{x:Static main:Strings.HeaderMessagePrompt}" />

        <TextBlock
            x:Name="dialogText"
            Grid.RowSpan="2"
            Width="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="24"
            Foreground="{DynamicResource textColor}"
            TextAlignment="Center"
            TextWrapping="Wrap">

            <TextBlock.Effect>
                <DropShadowEffect
                    BlurRadius="15"
                    ShadowDepth="0"
                    Color="#FF000000" />
            </TextBlock.Effect>

        </TextBlock>

        <StackPanel
            x:Name="buttonContainer"
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">

            <StackPanel.Resources>
                <Style
                    x:Key="{x:Type Button}"
                    BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}"
                    TargetType="{x:Type Button}">
                    <Setter Property="Width" Value="80" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="0,5,10,5" />
                    <Setter Property="BorderBrush" Value="Black" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{DynamicResource normalButtonColor}" />
                </Style>
            </StackPanel.Resources>

            <Button
                x:Name="noButton"
                Click="Button_Click"
                Content="{x:Static main:Strings.No}"
                Tag="{x:Static forms:DialogResult.No}" />

            <Button
                x:Name="okayButton"
                Click="Button_Click"
                Content="{x:Static main:Strings.OK}"
                Tag="{x:Static forms:DialogResult.OK}" />

            <Button
                x:Name="yesButton"
                Click="Button_Click"
                Content="{x:Static main:Strings.Yes}"
                Tag="{x:Static forms:DialogResult.Yes}" />

        </StackPanel>
    </Grid>
</Window>
