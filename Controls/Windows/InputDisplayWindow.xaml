<Window
    x:Class="Delfinovin.Controls.Windows.InputDisplayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Delfinovin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:main="clr-namespace:Delfinovin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static main:Strings.HeaderInputDisplay}"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border
            x:Name="mainBackground"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Background="{DynamicResource headerGradient}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="15,15,15,15" />

        <Border
            x:Name="greenScreenOverlay"
            Grid.RowSpan="3"
            Grid.ColumnSpan="2"
            Background="Green"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="15,15,15,15"
            Visibility="Hidden" />

        <ctrl:ApplicationTitleLabel x:Name="inputWindowHeader" HeaderText="{x:Static main:Strings.HeaderInputDisplay}" />

        <ctrl:WindowControls
            x:Name="windowControls"
            Grid.Column="1"
            HorizontalAlignment="Right" />

        <Viewbox
            x:Name="controllerContainer"
            Grid.Row="1"
            Grid.Column="1">

            <ctrl:GamecubeDialog x:Name="controllerDialog" Margin="70" />
        </Viewbox>

        <ListView
            x:Name="inputList"
            Grid.Row="1"
            Margin="10,0,0,0"
            Background="Transparent"
            BorderBrush="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Disabled">

            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListViewItem}">
                    <Setter Property="Height" Value="50" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListViewItem}">
                                <DockPanel LastChildFill="False">
                                    <ContentPresenter
                                        Height="35"
                                        HorizontalAlignment="Left"
                                        DockPanel.Dock="Top" />
                                    <Rectangle
                                        x:Name="inputDiv"
                                        Height="1"
                                        Margin="10,0,10,10"
                                        DockPanel.Dock="Bottom"
                                        RadiusX="3"
                                        RadiusY="3">

                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.8">
                                                <GradientStop Offset="0" Color="White" />
                                                <GradientStop Offset="1.0" Color="Transparent" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </DockPanel>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <StackPanel
            x:Name="windowOptions"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">

            <StackPanel.Resources>
                <Style BasedOn="{StaticResource MaterialDesignFlatAccentBgButton}" TargetType="{x:Type Button}">
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="0,5,7,10" />
                    <Setter Property="BorderBrush" Value="Black" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="Green" />
                </Style>
            </StackPanel.Resources>

            <Button
                x:Name="displayGreenScreen"
                Click="DisplayGreenScreen_Click"
                ToolTip="{x:Static main:Strings.ToolTipGreenscreen}">

                <Image Source="/Delfinovin;component/Resources/Icons/green-screen.png" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
