<Window
    x:Class="Delfinovin.Controls.Windows.ProgressDisplayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:Delfinovin.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:main="clr-namespace:Delfinovin"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{x:Static main:Strings.HeaderProgressWindow}"
    Width="730"
    Height="300"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border
            x:Name="mainBackground"
            Grid.RowSpan="3"
            Background="{DynamicResource headerGradient}"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="15,15,15,15" />

        <ctrl:ApplicationTitleLabel x:Name="progressWindowTitle" HeaderText="{x:Static main:Strings.HeaderProgressWindow}" />

        <ProgressBar
            x:Name="progressBar"
            Grid.Row="1"
            Width="600"
            Height="50"
            Margin="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource detailButtonHighlight}"
            Value="{Binding Progress}" />
    </Grid>

</Window>
